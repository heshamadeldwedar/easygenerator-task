# Dependencies - always install fresh in container
node_modules

# Build output - rebuild in container
dist

# Environment files - passed via build args
.env
.env.*
!.env.example

# Git
.git
.gitignore

# Design reference files (not needed for build)
design-reference

# IDE/Editor
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files (not needed in context)
Dockerfile*
docker-compose*
.dockerignore

# Documentation (except README)
*.md
!README.md

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage
