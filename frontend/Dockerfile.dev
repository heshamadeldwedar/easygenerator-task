# =============================================================================
# Development Dockerfile for Vite/React Frontend
# =============================================================================
#
# DEV MODEL: Source is bind-mounted from the host for live editing, but
# node_modules lives INSIDE the container (shadowed via anonymous volume in
# compose). This avoids host/container OS-arch mismatches for esbuild/rollup
# native binaries. The user does NOT need a perfectly matching host npm
# install for the container to run.
#
# Usage (via docker-compose.yml):
#   docker compose up --build
#
# =============================================================================

FROM node:24.16.0-alpine

WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./

# Install ALL dependencies
# Using npm ci for reproducible builds
RUN npm ci

# Port used by Vite dev server
EXPOSE 5173

# Start Vite dev server with host binding for Docker
# --host 0.0.0.0 makes it accessible from outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
