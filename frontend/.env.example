# =============================================================================
# Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# For Docker Compose: these are overridden by docker-compose.yml environment.
#
# NOTE: Vite requires VITE_ prefix for env vars to be exposed to the client.
# =============================================================================

# Backend API URL
# This is the URL the browser uses to call the backend API.
# Local dev / Docker: http://localhost:3000 (host-published port)
# Production: your backend domain (e.g., https://api.example.com)
VITE_API_BASE_URL=http://localhost:3000
