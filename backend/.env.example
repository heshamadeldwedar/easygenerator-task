# =============================================================================
# Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# For Docker Compose: these are overridden by docker-compose.yml environment.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# Database
# Local dev:    mongodb://localhost:27017/coursely
# Docker:       mongodb://mongo:27017/coursely (uses service name)
MONGO_URI=mongodb://localhost:27017/coursely

# JWT
JWT_ACCESS_SECRET=your-32-char-minimum-secret-key-here
JWT_ACCESS_EXPIRY=15m

# Refresh Token
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=your-32-char-minimum-cookie-secret

# CORS
# Must match the frontend origin (browser-side)
CORS_ORIGIN=http://localhost:5173

# Security
BCRYPT_ROUNDS=12
