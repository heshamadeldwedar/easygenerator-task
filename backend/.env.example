# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/easygenerator

# JWT
JWT_ACCESS_SECRET=your-32-char-minimum-secret-key-here
JWT_ACCESS_EXPIRY=15m

# Refresh Token
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=your-32-char-minimum-cookie-secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Security
BCRYPT_ROUNDS=12
